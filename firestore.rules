rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow create: if request.auth != null
        && request.resource.data.whiteId == request.auth.uid
        && request.resource.data.status == 'WAITING';
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.whiteId == request.auth.uid
          || resource.data.blackId == request.auth.uid
          || (resource.data.blackId == '' && request.resource.data.blackId == request.auth.uid));
      allow delete: if false;
    }
  }
}
